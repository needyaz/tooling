#!/usr/bin/env bash
# tooling-sync APP_DIR
# Copies VERSION, README.md, mk/ and bin/ of this repo into APP_DIR/tooling/, removes files that are no
# longer shipped, and writes APP_DIR/tooling/MANIFEST (sha256 and path, one per file).
set -euo pipefail

[ "$#" -eq 1 ] || { echo "usage: tooling-sync APP_DIR" >&2; exit 2; }
SRC="$(cd -P "$(dirname "$0")/.." && pwd -P)"
[ -d "$1" ] || { echo "✗ tooling-sync: no such directory: $1" >&2; exit 1; }
APP="$(cd -P "$1" && pwd -P)"
[ "$APP" != "$SRC" ] || { echo "✗ tooling-sync: APP_DIR is this repo" >&2; exit 1; }
DST="$APP/tooling"

if [ -e "$DST" ] && [ ! -f "$DST/MANIFEST" ] && [ -n "$(ls -A "$DST" 2>/dev/null)" ]; then
  echo "✗ tooling-sync: $DST exists and is not a vendored copy (no MANIFEST)" >&2
  exit 1
fi

if command -v sha256sum >/dev/null; then sha() { sha256sum "$1" | cut -d' ' -f1; }
else sha() { shasum -a 256 "$1" | cut -d' ' -f1; }; fi

rm -rf "$DST"
mkdir -p "$DST/mk" "$DST/bin"
cp -p "$SRC/VERSION" "$SRC/README.md" "$DST/"
cp -p "$SRC"/mk/* "$DST/mk/"
cp -p "$SRC"/bin/* "$DST/bin/"

(
  cd "$DST"
  find . -type f ! -name MANIFEST | sed 's,^\./,,' | LC_ALL=C sort | while IFS= read -r f; do
    printf '%s  %s\n' "$(sha "$f")" "$f"
  done > MANIFEST
)
echo "✓ tooling $(cat "$SRC/VERSION") vendored into $DST"
